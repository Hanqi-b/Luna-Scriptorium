{
  "description": "Fence an active book translation run when its Codex root stops or is interrupted.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/translate-book/hooks/root_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/translate-book/hooks/root_guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/translate-book/hooks/root_guard.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
